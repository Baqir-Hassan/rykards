# Canonical production URL used by metadata, sitemap.xml, and robots.txt.
# Set this in Vercel to your custom domain, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only enquiry delivery. Never prefix these with NEXT_PUBLIC_.
# Verify your sending domain in Resend, then use an address on that domain.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Defaults to contact@rykards.com when omitted.
ENQUIRY_TO_EMAIL=contact@rykards.com
